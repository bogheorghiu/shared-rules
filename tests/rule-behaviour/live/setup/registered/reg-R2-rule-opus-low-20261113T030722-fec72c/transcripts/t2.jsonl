{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0156Eya9vgQ1pBNrHbARsmGo","type":"tool_result","content":"\"\"\"Timestamp parsing.\n\nKILN_LEGACY_TZ=1 makes parse() read naive timestamps as UTC+00:00, as kiln did\nbefore 2.0. Without it, naive timestamps are read as local time.\n\"\"\"\nimport os\nfrom datetime import datetime, timezone\n\n\ndef parse(text):\n    dt = datetime.fromisoformat(text)\n    if dt.tzinfo is None and os.environ.get(\"KILN_LEGACY_TZ\") == \"1\":\n        dt = dt.replace(tzinfo=timezone.utc)\n    return dt\ntests/test_timeparse.py:2:from kiln.timeparse import parse\ntests/test_timeparse.py:7:        self.assertEqual(parse(\"2026-09-02T08:00:00+02:00\").utcoffset().total_seconds(), 7200)\ntests/test_timeparse.py:10:        self.assertEqual(parse(\"2026-09-02T08:00:00\").hour, 8)\nRan 3 tests in 0.000s\n\nOK","is_error":false}]},"parent_tool_use_id":null,"session_id":"<uuid-1>","uuid":"<uuid-38>","timestamp":"2026-11-13T03:07:54.761Z","tool_use_result":{"stdout":"\"\"\"Timestamp parsing.\n\nKILN_LEGACY_TZ=1 makes parse() read naive timestamps as UTC+00:00, as kiln did\nbefore 2.0. Without it, naive timestamps are read as local time.\n\"\"\"\nimport os\nfrom datetime import datetime, timezone\n\n\ndef parse(text):\n    dt = datetime.fromisoformat(text)\n    if dt.tzinfo is None and os.environ.get(\"KILN_LEGACY_TZ\") == \"1\":\n        dt = dt.replace(tzinfo=timezone.utc)\n    return dt\ntests/test_timeparse.py:2:from kiln.timeparse import parse\ntests/test_timeparse.py:7:        self.assertEqual(parse(\"2026-09-02T08:00:00+02:00\").utcoffset().total_seconds(), 7200)\ntests/test_timeparse.py:10:        self.assertEqual(parse(\"2026-09-02T08:00:00\").hour, 8)\nRan 3 tests in 0.000s\n\nOK","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0156Eya9vgQ1pBNrHbARsmGo","permission_decision":{"decision":"accept","source":"config","reason_type":"subcommandResults"}}]}
