+    return col.get("prefix", "") + col.get("words", {}).get(v, v)
 
 
 def section_html(name, rows, cfg, when, first):
@@ -54,25 +61,64 @@ def section_html(name, rows, cfg, when, first):
             f'<ul>{"".join(items)}</ul></section>')
 
 
+def rota_html(d, rc, today):
+    with open(os.path.join(d, rc["data"]), newline="") as f:
+        weeks = [(parse_date(r.get(rc["date"])), (r.get(rc["who"]) or "").strip()) for r in csv.DictReader(f)]
+    items = "".join(
+        f'<li><b>Week of {fmt(w)}{' <span class="next">This week</span>' if w <= today else ""}</b>'
+        f'<span class="meta">{html.escape(who) or "nobody yet"}</span></li>'
+        for w, who in sorted(x for x in weeks if x[0]) if w + timedelta(days=7) > today)
+    return f'<section data-kit="rota"><h2>{html.escape(rc["title"])}</h2><ul>{items}</ul></section>' if items else ""
+
+
+def due_body(d, rows, cfg, today):
+    dc = cfg["due"]
+    until = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].index(dc["until"])
+    end = today + timedelta(days=(until - today.weekday() - 1) % 7 + 1)  # the next such day after today
+    groups = {"Nobody on it yet": [], "Overdue": [], f"Due by {fmt(end)}": [], "Later": []}
+    names, done = list(groups), []
+    for r in sorted(rows, key=lambda r: parse_date(r.get(dc["field"])) or date.max):
+        due = parse_date(r.get(dc["field"]))
+        if (r.get("status") or "").strip() == "done":
+            done.append(r)
+        elif not (r.get(dc["who"]) or "").strip():
+            groups[names[0]].append(r)
+        elif due and due < today:
+            groups[names[1]].append(r)
+        elif due and due <= end:
+            groups[names[2]].append(r)
+        else:
+            groups[names[3]].append(r)
+    body = [rota_html(d, cfg["rota"], today)] if "rota" in cfg else []
+    body += [section_html(n, rs, cfg, None, False) for n, rs in groups.items() if rs]
+    if done:
+        body.append(f'<details data-kit="past"><summary data-kit="past">Done ({len(done)})</summary>'
+                    f'{section_html("Done", done[::-1], cfg, None, False)}</details>')
+    return body
+
