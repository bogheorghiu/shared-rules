 h1{font-size:1.4rem;margin:.2rem 0}p.purpose{margin:.2rem 0 1rem;color:#555}
@@ -34,7 +39,9 @@ def cell(col, row):
     v = (row.get(col["field"]) or "").strip()
     if not v:
         return col.get("empty", "")
-    return col.get("words", {}).get(v, v)
