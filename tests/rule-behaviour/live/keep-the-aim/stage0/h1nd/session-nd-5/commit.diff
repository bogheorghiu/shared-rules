+{
+ "title": "Committee tasks",
+ "purpose": "Each person's jobs, soonest due first, and the jobs with nobody's name on them. Done jobs are folded at the bottom.",
+ "data": "tasks.csv",
+ "section": {
+  "field": "who",
+  "empty": "Nobody yet"
+ },
+ "sort": "due",
+ "fold": {
+  "field": "status",
+  "value": "done",
+  "label": "Done"
+ },
+ "columns": [
+  {
+   "field": "task",
+   "label": "What"
+  },
+  {
+   "field": "due",
+   "label": "Due",
+   "date": true
+  },
+  {
+   "field": "status",
+   "label": "Status",
+   "words": {
+    "done": "Done",
+    "todo": "To do",
+    "in_progress": "Under way",
+    "waiting": "Waiting"
+   }
+  },
+  {
+   "field": "waiting_on",
+   "label": "Waiting on",
+   "words": {
+    "council": "on the council",
+    "hinge delivery": "on the hinge delivery",
+    "broker": "on the broker",
+    "bank": "on the bank"
+   }
+  },
+  {
+   "field": "qty",
+   "label": "How many"
+  },
+  {
+   "field": "notes",
+   "label": "Notes"
+  }
+ ]
+}
