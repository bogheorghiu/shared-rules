@@ -6,6 +6,14 @@
 Reads boards/<name>/board.json and the CSV file it names ("data", relative to the board's folder) and writes
 boards/<name>/index.html. Rows are grouped into sections by the "section" field and ordered by the earliest date
 in each section; sections whose date has passed go under one fold at the bottom.
+
+Optional board.json keys, for boards that are not grouped by date (e.g. tasks grouped by person):
+  section.date may be left out; sections then keep the order they first appear in.
+  section.empty  heading for rows with a blank section field (default "Other").
+  sort           a date field; rows are put in that order first (blank dates last).
+  fold           {"field", "value", "label"}: rows whose field equals value go under one fold at the bottom.
+  a column with "date": true shows its value as a date, marked "overdue" if it has passed and the row is not
+  under the fold.
 """
 import csv, html, json, os, sys
 from datetime import date
@@ -30,14 +38,17 @@ def fmt(d):
     return f"{d:%a} {d.day} {d:%b %Y}"
 
 
-def cell(col, row):
+def cell(col, row, today=None, folded=True):
     v = (row.get(col["field"]) or "").strip()
     if not v:
         return col.get("empty", "")
+    d = parse_date(v) if col.get("date") else None
+    if d:
+        return f"due {fmt(d)}" + (" (overdue)" if not folded and today and d < today else "")
     return col.get("words", {}).get(v, v)
 
 
-def section_html(name, rows, cfg, when, first):
+def section_html(name, rows, cfg, when, first, today=None, folded=True):
     cols = cfg["columns"]
     left = sum(1 for r in rows if (r.get("status") or "").strip() != "done")
     head = html.escape(name) + (f' <span class="when">\u00b7 {fmt(when)}</span>' if when else "")
@@ -45,7 +56,7 @@ def section_html(name, rows, cfg, when, first):
     items = []
     for r in rows:
         title = html.escape(cell(cols[0], r))
-        meta = [html.escape(cell(c, r)) for c in cols[1:] if c["field"] != "notes" and cell(c, r)]
+        meta = [html.escape(cell(c, r, today, folded)) for c in cols[1:] if c["field"] != "notes" and cell(c, r)]
         note = "".join(f'<div class="note">{html.escape(cell(c, r))}</div>' for c in cols[1:] if c["field"] == "notes" and cell(c, r))
         sep = " \u00b7 "
         items.append(f'<li><b>{title}</b><span class="meta">{sep.join(meta)}</span>{note}</li>')
@@ -60,16 +71,26 @@ def build(d, today=None):
     with open(os.path.join(d, cfg["data"]), newline="") as f:
         rows = list(csv.DictReader(f))
     sec = cfg["section"]
-    groups = {}
-    for r in rows:
-        groups.setdefault((r.get(sec["field"]) or "").strip() or "Other", []).append(r)
+    if cfg.get("sort"):
+        rows.sort(key=lambda r: parse_date(r.get(cfg["sort"])) or date.max)
+    fold = cfg.get("fold")
+    folded = [r for r in rows if fold and (r.get(fold["field"]) or "").strip() == fold["value"]]
+    rows = [r for r in rows if r not in folded]
+    def group(rs):
+        groups = {}
+        for r in rs:
+            groups.setdefault((r.get(sec["field"]) or "").strip() or sec.get("empty", "Other"), []).append(r)
+        return groups
     def when(rs):
-        ds = [x for x in (parse_date(r.get(sec["date"])) for r in rs) if x]
+        ds = [x for x in (parse_date(r.get(sec.get("date"))) for r in rs) if x]
         return min(ds) if ds else None
-    ordered = sorted(groups.items(), key=lambda kv: (when(kv[1]) is None, when(kv[1]) or date.max))
+    ordered = sorted(group(rows).items(), key=lambda kv: (when(kv[1]) is None, when(kv[1]) or date.max))
     upcoming = [g for g in ordered if when(g[1]) is None or when(g[1]) >= today]
     past = [g for g in ordered if when(g[1]) is not None and when(g[1]) < today]
-    body = [section_html(n, rs, cfg, when(rs), i == 0 and when(rs) is not None) for i, (n, rs) in enumerate(upcoming)]
+    body = [section_html(n, rs, cfg, when(rs), i == 0 and when(rs) is not None, today, False) for i, (n, rs) in enumerate(upcoming)]
+    if folded:
+        inner = "".join(section_html(n, rs, cfg, None, False) for n, rs in group(folded).items())
+        body.append(f'<details data-kit="fold"><summary data-kit="fold">{html.escape(fold.get("label", fold["value"]))} ({len(folded)})</summary>{inner}</details>')
     if past:
         inner = "".join(section_html(n, rs, cfg, when(rs), False) for n, rs in reversed(past))
         body.append(f'<details data-kit="past"><summary data-kit="past">{html.escape(cfg.get("past_label", "Past"))} ({len(past)})</summary>{inner}</details>')
