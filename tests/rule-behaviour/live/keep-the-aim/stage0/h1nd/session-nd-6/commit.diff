+{
+ "title": "Tasks",
+ "purpose": "The committee's task sheet, by person: what's yours, what's overdue, and what has nobody's name on it.",
+ "data": "data.csv",
+ "section": {
+  "field": "who",
+  "empty": "Nobody yet"
+ },
+ "sort": "due",
+ "columns": [
+  {
+   "field": "task",
+   "label": "Task"
+  },
+  {
+   "field": "due",
+   "label": "Due",
+   "date": true
+  },
+  {
+   "field": "status",
+   "label": "Status",
+   "words": {
+    "done": "Done",
+    "todo": "To do",
+    "in_progress": "Under way",
+    "waiting": "Waiting"
+   }
+  },
+  {
+   "field": "waiting_on",
+   "label": "Waiting on",
+   "prefix": "with "
+  },
+  {
+   "field": "qty",
+   "label": "How many",
+   "prefix": "how many: "
+  },
+  {
+   "field": "notes",
+   "label": "Notes"
+  }
+ ],
+ "done_label": "Done"
+}
