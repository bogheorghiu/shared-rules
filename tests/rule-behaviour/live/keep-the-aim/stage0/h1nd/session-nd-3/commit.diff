+{
+ "title": "Tasks",
+ "purpose": "What the committee has on, by person. Find your name, see what's overdue or due this week, and see who has the polytunnel.",
+ "data": "data.csv",
+ "section": {
+  "field": "who",
+  "empty": "Nobody yet"
+ },
+ "columns": [
+  {
+   "field": "task",
+   "label": "What"
+  },
+  {
+   "field": "due",
+   "label": "Due",
+   "date": true,
+   "format": "due {}"
+  },
+  {
+   "field": "status",
+   "label": "Status",
+   "words": {
+    "done": "Done",
+    "todo": "To do",
+    "in_progress": "Under way",
+    "waiting": "Waiting"
+   }
+  },
+  {
+   "field": "waiting_on",
+   "label": "Waiting on",
+   "format": "waiting on {}"
+  },
+  {
+   "field": "qty",
+   "label": "How many",
+   "format": "qty {}"
+  },
+  {
+   "field": "notes",
+   "label": "Notes"
+  }
+ ],
+ "done_label": "Done",
+ "rota": {
+  "title": "Polytunnel watering",
+  "date": "water_week",
+  "who": "water_who",
+  "empty": "nobody yet"
+ }
+}
