 Reads boards/<name>/board.json and the CSV file it names ("data", relative to the board's folder) and writes
 boards/<name>/index.html. Rows are grouped into sections by the "section" field and ordered by the earliest date
 in each section; sections whose date has passed go under one fold at the bottom.
+
+Optional board.json settings (leave them out and nothing changes): section "date" can be left out (sections keep
+file order, nothing folds); section "empty" names the section for rows with a blank field (default "Other");
+"done_label" moves done rows into one fold with that name; "next_label" replaces the "Next" badge; a column can
+have "date": true (shown as "Mon 30 Nov 2026") and a "prefix" put before its value. Data with no "status" column
+gets no "still to do" line.
 """
 import csv, html, json, os, sys
 from datetime import date
@@ -34,14 +40,16 @@ def cell(col, row):
     v = (row.get(col["field"]) or "").strip()
     if not v:
         return col.get("empty", "")
-    return col.get("words", {}).get(v, v)
+    if col.get("date") and parse_date(v):
+        v = fmt(parse_date(v))
+    return col.get("prefix", "") + col.get("words", {}).get(v, v)
 
 
 def section_html(name, rows, cfg, when, first):
     cols = cfg["columns"]
     left = sum(1 for r in rows if (r.get("status") or "").strip() != "done")
     head = html.escape(name) + (f' <span class="when">\u00b7 {fmt(when)}</span>' if when else "")
-    head += ' <span class="next">Next</span>' if first else ""
+    head += f' <span class="next">{html.escape(cfg.get("next_label", "Next"))}</span>' if first else ""
     items = []
     for r in rows:
         title = html.escape(cell(cols[0], r))
@@ -50,7 +58,8 @@ def section_html(name, rows, cfg, when, first):
         sep = " \u00b7 "
         items.append(f'<li><b>{title}</b><span class="meta">{sep.join(meta)}</span>{note}</li>')
     status = f"{left} still to do" if left else "all done"
-    return (f'<section data-kit="section"><h2 data-kit="section">{head}</h2><p class="left" data-kit="left">{status}</p>'
+    status = f'<p class="left" data-kit="left">{status}</p>' if "status" in rows[0] else ""
+    return (f'<section data-kit="section"><h2 data-kit="section">{head}</h2>{status}'
             f'<ul>{"".join(items)}</ul></section>')
 
 
@@ -60,11 +69,18 @@ def build(d, today=None):
     with open(os.path.join(d, cfg["data"]), newline="") as f:
         rows = list(csv.DictReader(f))
