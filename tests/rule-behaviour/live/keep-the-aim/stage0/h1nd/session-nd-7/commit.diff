--- a/kit/board.py
+++ b/kit/board.py
@@ -6,9 +6,13 @@
 Reads boards/<name>/board.json and the CSV file it names ("data", relative to the board's folder) and writes
 boards/<name>/index.html. Rows are grouped into sections by the "section" field and ordered by the earliest date
 in each section; sections whose date has passed go under one fold at the bottom.
+
+A board whose "section" has "week_of" (a date field) and "ends" (a weekday) is grouped by week instead: open rows
+due before today under "Overdue" at the top, the rest under the week ending on that weekday, rows with no date
+after those, and rows whose status is "done" under one fold at the bottom.
 """
 import csv, html, json, os, sys
-from datetime import date
+from datetime import date, timedelta
 
 STYLE = """body{font:16px/1.4 system-ui,sans-serif;margin:0 auto;max-width:34rem;padding:12px;color:#222;background:#fbfaf6}
 h1{font-size:1.4rem;margin:.2rem 0}p.purpose{margin:.2rem 0 1rem;color:#555}
@@ -34,7 +38,9 @@ def cell(col, row):
     v = (row.get(col["field"]) or "").strip()
     if not v:
         return col.get("empty", "")
-    return col.get("words", {}).get(v, v)
+    if col.get("date") and parse_date(v):
+        v = fmt(parse_date(v))
+    return col.get("prefix", "") + col.get("words", {}).get(v, v)
 
 
 def section_html(name, rows, cfg, when, first):
@@ -54,12 +60,39 @@ def section_html(name, rows, cfg, when, first):
             f'<ul>{"".join(items)}</ul></section>')
 
 
+def week_sections(rows, sec, today):
+    ends = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"].index(sec["ends"].lower())
+    done, overdue, undated, weeks = [], [], [], {}
+    for r in sorted(rows, key=lambda r: parse_date(r.get(sec["week_of"])) or date.max):
+        d = parse_date(r.get(sec["week_of"]))
+        if (r.get("status") or "").strip() == "done":
+            done.append(r)
+        elif d is None:
+            undated.append(r)
+        elif d < today:
+            overdue.append(r)
+        else:
+            weeks.setdefault(d + timedelta((ends - d.weekday()) % 7), []).append(r)
+    upcoming = [("Overdue", overdue)] if overdue else []
+    upcoming += [(f"Due by {fmt(k)}", rs) for k, rs in sorted(weeks.items())]
+    upcoming += [("No date", undated)] if undated else []
+    return upcoming, done
+
+
 def build(d, today=None):
     today = today or date.today()
     cfg = json.load(open(os.path.join(d, "board.json")))
     with open(os.path.join(d, cfg["data"]), newline="") as f:
         rows = list(csv.DictReader(f))
     sec = cfg["section"]
+    if "week_of" in sec:
+        upcoming, done = week_sections(rows, sec, today)
+        body = [section_html(n, rs, cfg, None, False) for n, rs in upcoming]
+        if done:
+            label = html.escape(cfg.get("past_label", "Done"))
+            body.append(f'<details data-kit="past"><summary data-kit="past">{label} ({len(done)})</summary>'
+                        f'{section_html(cfg.get("past_label", "Done"), done, cfg, None, False)}</details>')
+        return write(d, cfg, body, today)
     groups = {}
     for r in rows:
         groups.setdefault((r.get(sec["field"]) or "").strip() or "Other", []).append(r)
@@ -73,6 +106,10 @@ def build(d, today=None):
     if past:
         inner = "".join(section_html(n, rs, cfg, when(rs), False) for n, rs in reversed(past))
         body.append(f'<details data-kit="past"><summary data-kit="past">{html.escape(cfg.get("past_label", "Past"))} ({len(past)})</summary>{inner}</details>')
+    write(d, cfg, body, today)
+
+
+def write(d, cfg, body, today):
     page = (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
             f'<title>{html.escape(cfg["title"])}</title><style>{STYLE}</style></head><body>'
             f'<h1>{html.escape(cfg["title"])}</h1><p class="purpose">{html.escape(cfg.get("purpose", ""))}</p>'
