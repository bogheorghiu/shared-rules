+def rota_html(rows, rota, today):
+    """A weekly rota kept in two side columns of the data (week start date, who). Shows this week and the weeks
+    after it, so it still reads right days after the page was built: each line carries its own date."""
+    weeks = sorted((parse_date(r.get(rota["week"])), (r.get(rota["who"]) or "").strip()) for r in rows
+                   if parse_date(r.get(rota["week"])))
+    items = []
+    for start, who in weeks:
+        if start + timedelta(days=7) <= today:
+            continue
+        badge = ' <span class="next">This week</span>' if start <= today else ""
+        name = html.escape(who) if who else html.escape(rota.get("empty", ""))
+        items.append(f'<li><b>{name}{badge}</b><span class="meta">week of {fmt(start)}</span></li>')
+    return f'<section data-kit="rota"><h2>{html.escape(rota["title"])}</h2><ul>{"".join(items)}</ul></section>'
+
