+def due_body(rows, cfg, today):
+    """Tasks sorted into: nobody named, overdue, due by the next meeting, later; done ones folded at the bottom."""
+    due = cfg["due"]
+    days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
+    meeting = today + timedelta(days=(days.index(due["meeting_day"]) - today.weekday() - 1) % 7 + 1)
+    groups = {k: [] for k in ("nobody", "overdue", "soon", "later", "done")}
+    for r in rows:
+        d = parse_date(r.get(due["field"]))
+        if is_done(r):
+            k = "done"
+        elif not (r.get(due["who"]) or "").strip():
+            k = "nobody"
+        elif d and d < today:
+            k = "overdue"
+        elif d and d <= meeting:
+            k = "soon"
+        else:
+            k = "later"
+        groups[k].append(r)
+    for rs in groups.values():
+        rs.sort(key=lambda r: parse_date(r.get(due["field"])) or date.max)
+    labels = due["labels"]
+    body = [section_html(labels[k], groups[k], cfg, meeting if k == "soon" else None, False)
+            for k in ("nobody", "overdue", "soon", "later") if groups[k]]
+    if groups["done"]:
+        inner = section_html(labels["done"], groups["done"], cfg, None, False)
+        body.append(f'<details data-kit="past"><summary data-kit="past">{html.escape(labels["done"])} ({len(groups["done"])})</summary>{inner}</details>')
+    return body
