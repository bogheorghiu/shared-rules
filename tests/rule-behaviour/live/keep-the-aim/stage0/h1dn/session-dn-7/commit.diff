+def is_done(r):
+    return (r.get("status") or "").strip().lower() == "done"
+
+
+def item_html(r, cols, badge=""):
+    title = html.escape(cell(cols[0], r)) + badge
+    meta = [html.escape(cell(c, r)) for c in cols[1:] if c["field"] != "notes" and cell(c, r)]
+    note = "".join(f'<div class="note">{html.escape(cell(c, r))}</div>' for c in cols[1:] if c["field"] == "notes" and cell(c, r))
+    return f'<li><b>{title}</b><span class="meta">{" · ".join(meta)}</span>{note}</li>'
+
+
+def rota_html(rows, rota, today):
+    """The rota is a separate list kept in two side columns of the same sheet; its rows are not the tasks' rows."""
+    weeks = sorted((d, (r.get(rota["who"]) or "").strip() or rota.get("empty", ""))
+                   for r in rows for d in [parse_date(r.get(rota["week"]))] if d)
+    coming = [(d, w) for d, w in weeks if (today - d).days < 7]
+    if not coming:
+        return ""
+    items = "".join(f'<li><b>{html.escape(w)}</b><span class="meta">week from {fmt(d)}</span>'
+                    + ('<span class="next">Now</span>' if d <= today else "") + "</li>" for d, w in coming)
+    return f'<section data-kit="rota"><h2>{html.escape(rota["title"])}</h2><ul>{items}</ul></section>'
+
+
+def people_body(rows, cfg, today):
+    """Tasks grouped by who has them: nobody's-name first, then by name; done tasks under one fold."""
+    sec, cols = cfg["section"], cfg["columns"]
+    def who(r):
+        v = (r.get(sec["field"]) or "").strip()
+        return v[:1].upper() + v[1:]
+    def due(r):
+        return parse_date(r.get(sec["date"]))
+    groups = {}
+    for r in rows:
+        if not is_done(r):
+            groups.setdefault(who(r), []).append(r)
+    body = []
+    for name in sorted(groups, key=lambda n: (n != "", n)):
+        rs = sorted(groups[name], key=lambda r: (due(r) is None, due(r) or date.max))
+        late = sum(1 for r in rs if due(r) and due(r) < today)
+        soon = sum(1 for r in rs if due(r) and 0 <= (due(r) - today).days < 7)
+        items = []
+        for r in rs:
+            d = due(r)
+            badge = (' <span class="late">overdue</span>' if d and d < today else
+                     ' <span class="soon">due this week</span>' if d and (d - today).days < 7 else "")
+            items.append(item_html(r, cols, badge))
+        counts = [f"{len(rs)} open"] + ([f"{late} overdue"] if late else []) + ([f"{soon} due this week"] if soon else [])
+        body.append(f'<section data-kit="section"><h2 data-kit="section">{html.escape(name or sec["empty"])}</h2>'
+                    f'<p class="left" data-kit="left">{", ".join(counts)}</p><ul>{"".join(items)}</ul></section>')
+    done = [r for r in rows if is_done(r)]
+    if done:
+        done_cols = [cols[0], {"field": sec["field"]}]
+        inner = "".join(item_html(r, done_cols) for r in done)
+        body.append(f'<details data-kit="past"><summary data-kit="past">{html.escape(cfg.get("done_label", "Done"))} ({len(done)})</summary>'
+                    f'<section><ul>{inner}</ul></section></details>')
+    return body
+
