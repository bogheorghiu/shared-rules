+{
+ "title": "Tasks",
+ "purpose": "What's on each person's list, what has nobody's name on it yet, and whose week it is in the polytunnel.",
+ "data": "data.csv",
+ "rota": {
+  "week": "water_week",
+  "who": "water_who",
+  "label": "Polytunnel watering",
+  "empty": "nobody yet"
+ },
+ "section": {
+  "field": "who",
+  "empty": "Nobody's name on it yet"
+ },
+ "sort": "due",
+ "done_label": "Done",
+ "columns": [
+  {
+   "field": "task",
+   "label": "What"
+  },
+  {
+   "field": "due",
+   "label": "Due",
+   "date": true,
+   "prefix": "due "
+  },
+  {
+   "field": "status",
+   "label": "Status",
+   "words": {
+    "done": "Done",
+    "todo": "To do",
+    "in_progress": "Under way",
+    "waiting": "Waiting"
+   }
+  },
+  {
+   "field": "waiting_on",
+   "label": "Waiting on",
+   "prefix": "with "
+  },
+  {
+   "field": "qty",
+   "label": "How many",
+   "prefix": "qty "
+  },
+  {
+   "field": "notes",
+   "label": "Notes"
+  }
+ ]
+}
