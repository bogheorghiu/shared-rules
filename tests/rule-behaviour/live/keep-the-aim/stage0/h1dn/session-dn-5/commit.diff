             f'<ul>{"".join(items)}</ul></section>')
 
 
+def rota_html(rota, rows, today):
+    weeks = sorted((d, (r.get(rota["who"]) or "").strip()) for r in rows if (d := parse_date(r.get(rota["week"]))))
+    current = max((d for d, _ in weeks if d <= today), default=None)
