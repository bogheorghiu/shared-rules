+            items.append(f'<li>Week of {fmt(d)}{badge}<span class="meta"> \u00b7 {html.escape(who or rota["empty"])}</span></li>')
+    return f'<section data-kit="rota"><h2>{html.escape(rota["title"])}</h2><ul>{"".join(items)}</ul></section>'
