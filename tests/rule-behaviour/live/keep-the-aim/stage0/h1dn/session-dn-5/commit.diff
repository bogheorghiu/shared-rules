-    return col.get("words", {}).get(v, v)
+    if col.get("show_label"):
+        return f'{col["label"]}: {v}'
+    return col.get("words", {}).get(v.lower(), v)
+
+
+def is_done(row):
+    return (row.get("status") or "").strip().lower() == "done"
