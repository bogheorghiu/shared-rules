+def task_body(rows, cfg, today):
+    due = cfg["section"]["due"]
+    meeting = today + timedelta(days=(MEETING_WEEKDAY - today.weekday()) % 7)
+    key = lambda r: parse_date(r.get(due)) or date.max
+    todo = sorted((r for r in rows if not is_done(r)), key=key)
+    done = sorted((r for r in rows if is_done(r)), key=key, reverse=True)
+    groups = [("Overdue", None, [r for r in todo if key(r) < today]),
+              ("Due by the meeting", meeting, [r for r in todo if today <= key(r) <= meeting]),
+              ("Later", None, [r for r in todo if key(r) > meeting])]
+    body = [rota_html(rows, cfg["rota"], today)] if cfg.get("rota") else []
+    body += [section_html(n, rs, cfg, w, False) for n, w, rs in groups if rs]
+    if done:
