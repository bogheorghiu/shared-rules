+def rota_html(rows, rota, today):
+    monday = today - timedelta(days=today.weekday())
+    weeks = sorted((w, (r.get(rota["who"]) or "").strip()) for r in rows
+                   if (w := parse_date(r.get(rota["week"]))) and w >= monday)
+    if not weeks:
+        return ""
+    items = "".join(f'<li><b>w/c {fmt(w)}{" <span class=next>This week</span>" if w == monday else ""}</b>'
+                    f'<span class="meta">{html.escape(who) if who else "<span class=late>nobody yet</span>"}</span></li>'
+                    for w, who in weeks)
+    return f'<section data-kit="rota"><h2>{html.escape(rota["label"])}</h2><ul>{items}</ul></section>'
+
