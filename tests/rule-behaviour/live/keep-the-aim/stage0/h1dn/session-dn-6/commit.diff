+def build_tasks(d, cfg, rows, today):
+    sec = cfg["section"]
+    empty = sec.get("empty", "Other")
+
+    def grouped(rs):
+        # Group case-insensitively ("priya" and "Priya"), labelled by the commonest spelling.
+        groups = {}
+        for r in rs:
+            groups.setdefault((r.get(sec["field"]) or "").strip().casefold(), []).append(r)
+        out = []
+        for k, g in groups.items():
+            label = Counter((r.get(sec["field"]) or "").strip() for r in g).most_common(1)[0][0] if k else empty
