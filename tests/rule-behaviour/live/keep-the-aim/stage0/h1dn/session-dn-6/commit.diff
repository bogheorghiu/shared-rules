+{
+ "title": "Tasks",
+ "purpose": "The committee's jobs, by person: what's yours, what's overdue, what has nobody on it, and whose week it is in the polytunnel.",
+ "data": "tasks.csv",
+ "section": {
+  "field": "who",
+  "empty": "Nobody yet"
+ },
+ "due": "due",
+ "columns": [
+  {
+   "field": "task",
+   "label": "What"
+  },
+  {
+   "field": "status",
+   "label": "Status",
+   "words": {
+    "done": "Done",
+    "todo": "To do",
+    "in_progress": "Under way",
+    "waiting": "Waiting"
+   }
+  },
+  {
+   "field": "waiting_on",
+   "label": "Waiting on",
+   "prefix": "with "
+  },
+  {
+   "field": "qty",
+   "label": "How many",
+   "prefix": "how many: "
+  },
+  {
+   "field": "notes",
+   "label": "Notes"
+  }
+ ],
+ "done_label": "Done",
+ "rota": {
+  "label": "Polytunnel watering",
+  "week": "water_week",
+  "who": "water_who",
+  "empty": "nobody yet"
+ }
+}
