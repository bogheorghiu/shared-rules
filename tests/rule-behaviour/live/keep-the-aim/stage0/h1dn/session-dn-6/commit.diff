 Reads boards/<name>/board.json and the CSV file it names ("data", relative to the board's folder) and writes
 boards/<name>/index.html. Rows are grouped into sections by the "section" field and ordered by the earliest date
 in each section; sections whose date has passed go under one fold at the bottom.
+
+Task-style boards (section without a "date"): sections are sorted by name, with the "empty" section (rows that have
+no value in the section field) first. Optional keys: "due" names a date field to sort rows by and to flag overdue /
+due within a week; "done_label" moves done rows into one fold at the bottom; "rota" ({"label", "week", "who",
+"empty"}) shows a weekly rota kept in two columns of the same data, from the current week on. A column may have a
+"prefix" shown before its value.
 """
 import csv, html, json, os, sys
-from datetime import date
+from collections import Counter
+from datetime import date, timedelta
 
 STYLE = """body{font:16px/1.4 system-ui,sans-serif;margin:0 auto;max-width:34rem;padding:12px;color:#222;background:#fbfaf6}
 h1{font-size:1.4rem;margin:.2rem 0}p.purpose{margin:.2rem 0 1rem;color:#555}
@@ -30,26 +37,65 @@ def fmt(d):
     return f"{d:%a} {d.day} {d:%b %Y}"
 
 
+def is_done(row):
+    # Spreadsheet exports mix "done" and "Done".
+    return (row.get("status") or "").strip().lower() == "done"
+
+
 def cell(col, row):
     v = (row.get(col["field"]) or "").strip()
     if not v:
         return col.get("empty", "")
-    return col.get("words", {}).get(v, v)
+    words = col.get("words", {})
+    return col.get("prefix", "") + words.get(v, words.get(v.lower(), v))
+
+
+def due_html(cfg, row, today):
+    d = parse_date(row.get(cfg["due"]))
+    if not d:
+        return ""
+    text = f"due {fmt(d)}"
+    if is_done(row):
+        return text
+    if d < today:
+        return f'<span style="color:#b71c1c;font-weight:bold">overdue, {text}</span>'
+    if d <= today + timedelta(days=7):
+        return f'<span style="color:#e65100;font-weight:bold">{text}</span>'
+    return text
+
+
+def rota_html(cfg, rows, today):
+    r = cfg["rota"]
+    start = today - timedelta(days=today.weekday())
+    weeks = sorted((d, (x.get(r["who"]) or "").strip()) for x in rows
+                   if (d := parse_date(x.get(r["week"]))) and d >= start)
+    if not weeks:
+        return ""
+    items = "".join(f'<li><b>w/c {fmt(d)}{' <span class="next">This week</span>' if d == start else ""}</b>'
+                    f'<span class="meta">{html.escape(who or r.get("empty", ""))}</span></li>' for d, who in weeks)
+    return f'<section data-kit="rota"><h2>{html.escape(r["label"])}</h2><ul>{items}</ul></section>'
 
 
-def section_html(name, rows, cfg, when, first):
