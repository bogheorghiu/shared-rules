+    still = [r for r in rows if not (done and is_done(r))]
+    body = [rota_html(cfg, rows, today)] if cfg.get("rota") else []
+    body += [section_html(n, rs, cfg, None, False, today) for n, rs in grouped(still)]
+    if done:
+        inner = "".join(section_html(n, rs, cfg, None, False, today) for n, rs in grouped(done))
+        body.append(f'<details data-kit="done"><summary data-kit="done">{html.escape(cfg["done_label"])} ({len(done)})</summary>{inner}</details>')
+    write_page(d, cfg, "".join(body), today)
