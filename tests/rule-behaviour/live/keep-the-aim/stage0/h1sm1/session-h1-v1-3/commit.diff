+section.nobody{border-color:#c62828}section.rota{border-color:#2e7d32}.big{font-size:1.2rem;margin:.2rem 0}"""
+TASK_WORDS = {"todo": "To do", "in_progress": "Under way", "waiting": "Waiting"}
+
+
+def page_html(cfg, body, today, extra_style=""):
+    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
+            f'<title>{html.escape(cfg["title"])}</title><style>{STYLE}{extra_style}</style></head><body>'
+            f'<h1>{html.escape(cfg["title"])}</h1><p class="purpose">{html.escape(cfg.get("purpose", ""))}</p>'
+            f'{"".join(body)}<footer>Updated {fmt(today)}</footer></body></html>\n')
+
+
+def build_tasks(cfg, rows, today):
+    """The committee's task sheet: polytunnel rota first (checked at the gate), then open tasks nobody has taken,
+    then each person's open tasks by due date, with done ones folded away at the bottom."""
+    # The export comes from a hand-kept spreadsheet: "Done"/"done" and "priya"/"Priya" are the same thing.
+    for r in rows:
+        r["status"] = (r.get("status") or "").strip().lower()
+        who = (r.get("who") or "").strip()
+        r["who"] = who[:1].upper() + who[1:]
+
+    def item(r, with_who=False):
+        due = parse_date(r.get("due"))
+        tags = ""
+        if r["status"] != "done" and due:
+            if due < today:
+                tags += '<span class="tag late">overdue</span>'
+            elif (due - today).days <= 7:
+                tags += '<span class="tag soon">this week</span>'
+        waiting_on = (r.get("waiting_on") or "").strip()
+        if r["status"] != "done" and waiting_on:
+            tags += f'<span class="tag wait">waiting on {html.escape(waiting_on)}</span>'
+        meta = [f"due {fmt(due)}" if due else "no date"]
+        if with_who:
+            meta.insert(0, html.escape(r["who"]) or "nobody yet")
+        if r["status"] in TASK_WORDS:
+            meta.append(TASK_WORDS[r["status"]])
+        if (r.get("qty") or "").strip():
+            meta.append("qty " + html.escape(r["qty"].strip()))
+        note = (r.get("notes") or "").strip()
+        note = f'<div class="note">{html.escape(note)}</div>' if note else ""
+        return f'<li><b>{html.escape(r["task"].strip())}{tags}</b><span class="meta">{" · ".join(meta)}</span>{note}</li>'
+
+    def by_due(rs):
+        return sorted(rs, key=lambda r: parse_date(r.get("due")) or date.max)
+
+    body = []
+    # The rota lives in two side columns of the same sheet; its rows have nothing to do with the task on that line.
+    rota = sorted((d, (r.get("water_who") or "").strip()) for r in rows if (d := parse_date(r.get("water_week"))))
+    if rota:
+        current = [x for x in rota if x[0] <= today][-1:] or rota[:1]
+        i = rota.index(current[0])
+        now, nxt = rota[i], rota[i + 1] if i + 1 < len(rota) else None
+        lines = "".join(f'<li><b>Week of {fmt(d)}</b><span class="meta">{html.escape(w) or "nobody yet"}</span></li>'
+                        for d, w in rota[i:])
+        body.append(f'<section class="rota" data-kit="rota"><h2>Polytunnel watering</h2>'
+                    f'<p class="big">This week: <b>{html.escape(now[1]) or "nobody yet"}</b></p>'
+                    + (f'<p class="left">Next week (from {fmt(nxt[0])}): {html.escape(nxt[1]) or "nobody yet"}</p>' if nxt else "")
+                    + f'<details><summary>Whole rota</summary><ul>{lines}</ul></details></section>')
+
+    open_rows = [r for r in rows if r["status"] != "done" and (r.get("task") or "").strip()]
+    nobody = by_due(r for r in open_rows if not r["who"])
+    if nobody:
+        body.append(f'<section class="nobody" data-kit="nobody"><h2>Nobody\'s name on it yet</h2>'
+                    f'<p class="left">{len(nobody)} open, oldest first</p><ul>{"".join(item(r) for r in nobody)}</ul></section>')
+    people = {}
+    for r in open_rows:
+        if r["who"]:
+            people.setdefault(r["who"], []).append(r)
+    for who in sorted(people):
+        rs = by_due(people[who])
+        late = sum(1 for r in rs if (parse_date(r.get("due")) or date.max) < today)
+        left = f"{len(rs)} open" + (f", {late} overdue" if late else "")
+        body.append(f'<section data-kit="person"><h2>{html.escape(who)}</h2><p class="left">{left}</p>'
+                    f'<ul>{"".join(item(r) for r in rs)}</ul></section>')
+    done = [r for r in rows if r["status"] == "done" and (r.get("task") or "").strip()]
+    if done:
+        done.sort(key=lambda r: parse_date(r.get("due")) or date.min, reverse=True)
+        body.append(f'<details data-kit="past"><summary>Done ({len(done)})</summary><ul>'
+                    f'{"".join(item(r, with_who=True) for r in done)}</ul></details>')
+    return page_html(cfg, body, today, TASK_STYLE)
+
+
