--- /dev/null
+++ b/kit/tasks_layout.py
@@ -0,0 +1,134 @@
+"""Page layout for the committee task board (board.json "layout": "tasks").
+
+Built for the task sheet export (incoming/tasks.csv) and for what the committee asked for in the minutes of
+29 Oct-12 Nov 2026: what's overdue and what's due by next Thursday comes first, each person can open just
+their own list, anything with nobody's name on it is flagged, things waiting on someone outside are grouped by
+who (the council holds several of them), and done tasks are kept out of the way. The water_week/water_who
+columns are the polytunnel watering rota, which only shares the sheet with the tasks. It is shown as its own list.
+"""
+import csv, html, os
+from datetime import timedelta
+
+from board import STYLE, fmt, parse_date
+
+EXTRA_STYLE = """.flag{color:#b71c1c;font-weight:bold}.late{background:#b71c1c;color:#fff;border-radius:4px;padding:0 6px;font-size:.8rem}
+.soon{background:#ef6c00;color:#fff;border-radius:4px;padding:0 6px;font-size:.8rem}p.sum{margin:0 0 12px}
+.rota li{display:flex;justify-content:space-between}h3{font-size:1rem;margin:.6rem 0 .2rem}"""
+
+STATUS = {"todo": "To do", "in_progress": "Under way", "waiting": "Waiting", "done": "Done"}
+WEEK = timedelta(days=7)
+
+
+def soon_until(today):
+    """The committee meets on Thursdays and asks what is due by next Thursday: the first Thursday a week or more off."""
+    d = today + WEEK
+    return d + timedelta(days=(3 - d.weekday()) % 7)
+
+
+def short(d):
+    return f"{d:%a} {d.day} {d:%b}"
+
+
+def clean(row):
+    r = {k: (v or "").strip() for k, v in row.items()}
+    r["status"] = r.get("status", "").lower()  # the export has both "done" and "Done"
+    r["who"] = r.get("who", "").title()  # and both "Priya" and "priya"
+    r["due_d"] = parse_date(r.get("due"))
+    return r
+
+
+def item(r, today, show_who=True):
+    due = r["due_d"]
+    soon = soon_until(today)
+    tag = ""
+    if due and r["status"] != "done":
+        if due < today:
+            late = (today - due).days
+            tag = f' <span class="late">{late} day{"s" if late != 1 else ""} late</span>'
+        elif due <= soon:
+            tag = ' <span class="soon">due soon</span>'
+    meta = []
+    if show_who:
+        meta.append(html.escape(r["who"]) if r["who"] else '<span class="flag">nobody yet</span>')
+    if due:
+        meta.append("due " + short(due))
+    meta.append(STATUS.get(r["status"], html.escape(r["status"])))
+    if r.get("waiting_on") and r["status"] != "done":
+        meta.append("waiting on " + html.escape(r["waiting_on"]))
+    note = " ".join(x for x in (r.get("qty", ""), r.get("notes", "")) if x)  # e.g. "3" + "loads"
+    note = f'<div class="note">{html.escape(note)}</div>' if note else ""
+    return f'<li><b>{html.escape(r["task"])}{tag}</b><span class="meta">{" · ".join(meta)}</span>{note}</li>'
+
+
+def block(title, rows, today, show_who=True, empty="Nothing here."):
+    inner = "".join(item(r, today, show_who) for r in rows) or f'<li class="note">{empty}</li>'
+    return f'<section><h2>{title}</h2><ul>{inner}</ul></section>'
+
+
+def rota_html(rows, today):
+    weeks = sorted((d, r.get("water_who", "")) for r in rows if (d := parse_date(r.get("water_week"))))
+    current = [(d, w) for d, w in weeks if d + WEEK > today]
+    if not current:
+        return ""
+    def who(w):
+        return html.escape(w.title()) if w else '<span class="flag">nobody yet</span>'
+    lines = "".join(f'<li><span>{"This week" if d <= today else "w/c " + short(d)}</span><span>{who(w)}</span></li>'
+                    for d, w in current)
+    return (f'<section class="rota"><h2>Polytunnel watering</h2><p class="left">Week starting Monday. '
+            f'Swaps go in the task sheet so they show here.</p><ul>{lines}</ul></section>')
+
+
+def build(d, cfg, today):
+    with open(os.path.join(d, cfg["data"]), newline="") as f:
+        rows = [clean(r) for r in csv.DictReader(f)]
+    tasks = [r for r in rows if r.get("task")]
+    by_due = lambda r: (r["due_d"] is None, r["due_d"] or today)
+    open_ = sorted((r for r in tasks if r["status"] != "done"), key=by_due)
+    done = sorted((r for r in tasks if r["status"] == "done"), key=by_due, reverse=True)
+
+    overdue = [r for r in open_ if r["due_d"] and r["due_d"] < today]
+    soon = soon_until(today)
+    week = [r for r in open_ if r["due_d"] and today <= r["due_d"] <= soon]
+    # Waiting lists everything held up outside, even if it is also overdue or due soon, so the count per
+    # party is the whole count (the council will not act until the society names a contact).
+    waiting = [r for r in open_ if r["status"] == "waiting" or r.get("waiting_on")]
+    shown = {id(r) for r in overdue + week + waiting}
+    later = [r for r in open_ if id(r) not in shown]
+    nobody = [r for r in open_ if not r["who"]]
+
+    sums = [f"{len(overdue)} overdue", f"{len(week)} due by {short(soon)}", f"{len(open_)} open in all"]
+    if nobody:
+        sums.append(f'<span class="flag">{len(nobody)} with nobody\'s name on</span>')
+
+    groups = {}
+    for r in waiting:
+        groups.setdefault(r["waiting_on"].title() or "Someone", []).append(r)
+    wait_inner = "".join(f'<h3>{html.escape(k)} ({len(v)})</h3><ul>{"".join(item(r, today) for r in v)}</ul>'
+                         for k, v in sorted(groups.items(), key=lambda kv: -len(kv[1])))
+    wait_sec = f'<section><h2>Waiting on someone else</h2>{wait_inner}</section>' if waiting else ""
+
+    people = {}
+    for r in open_:
+        people.setdefault(r["who"], []).append(r)
+    person_html = ""
+    if "" in people:
+        person_html += (f'<details><summary class="flag">Nobody yet ({len(people[""])})</summary>'
+                        f'<ul>{"".join(item(r, today, False) for r in people[""])}</ul></details>')
+    for name in sorted(n for n in people if n):
+        person_html += (f'<details><summary>{html.escape(name)} ({len(people[name])})</summary>'
+                        f'<ul>{"".join(item(r, today, False) for r in people[name])}</ul></details>')
+
+    body = [
+        f'<p class="sum">{" · ".join(sums)}</p>',
+        f'<section><h2>Each person\'s tasks</h2>{person_html}</section>',
+        block("Overdue", overdue, today, empty="Nothing overdue."),
+        block(f"Due by {short(soon)}", week, today, empty="Nothing due by then."),
+        wait_sec,
+        rota_html(rows, today),
+        f'<details><summary>Later ({len(later)})</summary><ul>{"".join(item(r, today) for r in later)}</ul></details>',
+        f'<details><summary>Done ({len(done)})</summary><ul>{"".join(item(r, today) for r in done)}</ul></details>',
+    ]
+    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
+            f'<title>{html.escape(cfg["title"])}</title><style>{STYLE}\n{EXTRA_STYLE}</style></head><body>'
+            f'<h1>{html.escape(cfg["title"])}</h1><p class="purpose">{html.escape(cfg.get("purpose", ""))}</p>'
+            f'{"".join(body)}<footer>Updated {fmt(today)}. "Overdue" and "due soon" are as of that day.</footer></body></html>\n')
