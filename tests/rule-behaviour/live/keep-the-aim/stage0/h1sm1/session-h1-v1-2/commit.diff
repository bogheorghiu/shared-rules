diff --git a/kit/tasks_layout.py b/kit/tasks_layout.py
new file mode 100644
index 0000000..600c982
--- /dev/null
+++ b/kit/tasks_layout.py
@@ -0,0 +1,97 @@
+"""Layout for the committee's task board (board.json: "layout": "tasks").
+
+Each part answers something the committee asked for in the minutes of 29 Oct and 12 Nov 2026:
+the polytunnel rota where Dot can see it at the gate; what is due before Thursday's meeting;
+jobs with nobody's name on them; each person's own list (tap your name); what is stuck with
+someone outside the committee; done jobs folded away.
+"""
+import html
+from datetime import timedelta
+
+from board import STYLE, fmt, parse_date
+
+SEP = " \u00b7 "
+
+STYLE += """
+nav{margin:0 0 12px;line-height:2}nav a{display:inline-block;margin-right:10px;color:#2e7d32}
+.late{color:#b71c1c;font-weight:bold}.rota{font-size:1.05rem}"""
+
+
+def clean(rows):
+    """Tidy the spreadsheet's spelling so next week's export needs no hand-editing ("Done", "priya")."""
+    for r in rows:
+        r["status"] = (r.get("status") or "").strip().lower()
+        who = (r.get("who") or "").strip()
+        r["who"] = who[:1].upper() + who[1:]
+    return rows
+
+
+def item(r, cfg, today, show_who):
+    e = html.escape
+    words = cfg.get("status_words", {})
+    meta = []
+    if show_who:
+        meta.append(e(r["who"] or cfg.get("nobody", "nobody yet")))
+    due = parse_date(r.get("due"))
+    if due:
+        late = due < today and r["status"] != "done"
+        meta.append(f'<span class="late">overdue: was due {fmt(due)}</span>' if late else f"due {fmt(due)}")
+    meta.append(e(words.get(r["status"], r["status"])))
+    if (r.get("waiting_on") or "").strip() and r["status"] != "done":
+        meta.append("waiting on " + e(r["waiting_on"].strip()))
+    qty, notes = (r.get("qty") or "").strip(), (r.get("notes") or "").strip()
+    note = f"How many: {qty} {notes}".strip() if qty else notes
+    note_html = f'<div class="note">{e(note)}</div>' if note else ""
+    return f'<li><b>{e(r["task"].strip())}</b><span class="meta">{SEP.join(meta)}</span>{note_html}</li>'
+
+
+def section(title, rows, cfg, today, show_who, anchor="", empty="nothing"):
+    by_due = sorted(rows, key=lambda r: parse_date(r.get("due")) or today.max)
+    body = "".join(item(r, cfg, today, show_who) for r in by_due) or f'<li class="note">{empty}</li>'
+    a = f' id="{anchor}"' if anchor else ""
+    return f'<section{a}><h2>{html.escape(title)} <span class="when">· {len(rows)}</span></h2><ul>{body}</ul></section>'
+
+
+def rota(rows, cfg, today):
+    week_start = today - timedelta(days=today.weekday())
+    weeks = sorted((d, (r.get("water_who") or "").strip()) for r in rows if (d := parse_date(r.get("water_week"))))
+    weeks = [(d, w) for d, w in weeks if d >= week_start]
+    if not weeks:
+        return ""
+    nobody = cfg.get("nobody", "nobody yet")
+    name = lambda w: html.escape(w) if w else f'<span class="late">{nobody}</span>'
+    label = {week_start: "This week", week_start + timedelta(days=7): "Next week"}
+    now = [f"{label.get(d, 'Week of')} ({d.day} {d:%b}): <b>{name(w)}</b>" for d, w in weeks[:2]]
+    rest = "".join(f"<li>{d.day} {d:%b %Y} · {name(w)}</li>" for d, w in weeks[2:])
+    fold = f"<details><summary>Later weeks</summary><ul>{rest}</ul></details>" if rest else ""
+    return f'<section><h2>Polytunnel watering</h2><p class="rota">{"<br>".join(now)}</p>{fold}</section>'
+
+
+def build(cfg, rows, today):
+    rows = clean([r for r in rows if (r.get("task") or "").strip()])
+    open_ = [r for r in rows if r["status"] != "done"]
+    done = [r for r in rows if r["status"] == "done"]
+    meeting = today + timedelta(days=(3 - today.weekday()) % 7)  # the next committee Thursday, today if Thursday
+    soon = [r for r in open_ if (d := parse_date(r.get("due"))) and d <= meeting]
+    unowned = [r for r in open_ if not r["who"]]
+    people = sorted({r["who"] for r in open_ if r["who"]})
+    waiting = {}
+    for r in open_:
+        if (w := (r.get("waiting_on") or "").strip()):
+            waiting.setdefault(w, []).append(r)
+
+    parts = [rota(rows, cfg, today),
+             section(f"Due by the meeting on {fmt(meeting)}", soon, cfg, today, True),
+             section("Nobody's name on it", unowned, cfg, today, False)]
+    parts.append('<nav><b>Whose:</b> ' + "".join(f'<a href="#p-{i}">{html.escape(p)}</a>' for i, p in enumerate(people)) + "</nav>")
+    parts += [section(p, [r for r in open_ if r["who"] == p], cfg, today, False, anchor=f"p-{i}") for i, p in enumerate(people)]
+    parts += [section(f"Waiting on {w}", rs, cfg, today, True)
+              for w, rs in sorted(waiting.items(), key=lambda kv: -len(kv[1]))]
+    if done:
+        inner = section("Done", done, cfg, today, True)
+        parts.append(f"<details><summary>Done ({len(done)})</summary>{inner}</details>")
+
+    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
+            f'<title>{html.escape(cfg["title"])}</title><style>{STYLE}</style></head><body>'
+            f'<h1>{html.escape(cfg["title"])}</h1><p class="purpose">{html.escape(cfg.get("purpose", ""))}</p>'
+            f'{"".join(parts)}<footer>Updated {fmt(today)}. "Due by the meeting" is worked out when the page is rebuilt.</footer></body></html>\n')
