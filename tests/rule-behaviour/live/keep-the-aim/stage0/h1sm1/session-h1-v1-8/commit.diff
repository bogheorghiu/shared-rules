--- a/kit/board.py
+++ b/kit/board.py
@@ -6,9 +6,11 @@
 Reads boards/<name>/board.json and the CSV file it names ("data", relative to the board's folder) and writes
 boards/<name>/index.html. Rows are grouped into sections by the "section" field and ordered by the earliest date
 in each section; sections whose date has passed go under one fold at the bottom.
+
+A board.json with "layout": "tasks" is built by build_tasks instead (see there).
 """
 import csv, html, json, os, sys
-from datetime import date
+from datetime import date, timedelta
 
 STYLE = """body{font:16px/1.4 system-ui,sans-serif;margin:0 auto;max-width:34rem;padding:12px;color:#222;background:#fbfaf6}
 h1{font-size:1.4rem;margin:.2rem 0}p.purpose{margin:.2rem 0 1rem;color:#555}
@@ -54,11 +56,124 @@ def section_html(name, rows, cfg, when, first):
             f'<ul>{"".join(items)}</ul></section>')
 
 
+TASK_STYLE = """nav{margin:0 0 12px;font-size:.95rem}nav a{display:inline-block;margin:0 10px 6px 0}
+.tag{border-radius:4px;padding:0 6px;font-size:.8rem;margin-left:6px;font-weight:normal;color:#fff}.late{background:#c62828}.soon{background:#ef6c00}
+.big{font-size:1.3rem;font-weight:bold;margin:.2rem 0}"""
+
+STATUS_WORDS = {"done": "Done", "todo": "To do", "in_progress": "Under way", "waiting": "Waiting"}
+
+
+def build_tasks(rows, today):
+    """The committee's task sheet, laid out for reading on a phone.
+
+    The sheet's export is used as it comes, so its quirks are absorbed here rather than fixed by hand each week:
+    status and names are matched regardless of case. Sections, in order:
+      - the polytunnel rota (the sheet's water_week/water_who side columns), because Dot checks it at the gate;
+      - everything overdue or due by the meeting after next, which is what the Thursday meeting needs to get to;
+      - each person's open tasks, nobody-yet first, so anyone can find their own name and unowned jobs stand out;
+      - done tasks, folded away.
+    """
+    def norm_who(s):
+        s = (s or "").strip()
+        return s[:1].upper() + s[1:]
+
+    def status(r):
+        return (r.get("status") or "").strip().lower()
+
+    # "This week" runs to the first Thursday at least 7 days away: whenever the board is rebuilt, that covers
+    # everything due before the committee meets again after the coming meeting.
+    horizon = today + timedelta(days=7)
+    horizon += timedelta(days=(3 - horizon.weekday()) % 7)
+
+    tasks = [r for r in rows if (r.get("task") or "").strip()]
+    open_ = sorted((r for r in tasks if status(r) != "done"), key=lambda r: parse_date(r.get("due")) or date.max)
+    done = [r for r in tasks if status(r) == "done"]
+
+    def item(r, show_who):
+        due = parse_date(r.get("due"))
+        tag = ""
+        if status(r) != "done" and due and due < today:
+            tag = '<span class="tag late">Overdue</span>'
+        elif status(r) != "done" and due and due <= horizon:
+            tag = '<span class="tag soon">Due soon</span>'
+        meta = []
+        if show_who:
+            meta.append(norm_who(r.get("who")) or "nobody yet")
+        if due:
+            meta.append(f"due {fmt(due)}")
+        on = (r.get("waiting_on") or "").strip()
+        if status(r) == "waiting" and on:
+            meta.append(f"Waiting on {on}")
+        else:
+            meta.append(STATUS_WORDS.get(status(r), (r.get("status") or "").strip()))
+            if on:
+                meta.append(f"waiting on {on}")
+        if (r.get("qty") or "").strip():
+            meta.append(f"quantity {r['qty'].strip()}")
+        note = (r.get("notes") or "").strip()
+        note = f'<div class="note">{html.escape(note)}</div>' if note else ""
+        sep = " · "
+        return (f'<li><b>{html.escape(r["task"].strip())}{tag}</b>'
+                f'<span class="meta">{html.escape(sep.join(m for m in meta if m))}</span>{note}</li>')
+
+    def section(anchor, head, sub, items):
+        return (f'<section id="{anchor}"><h2>{head}</h2><p class="left">{sub}</p><ul>{"".join(items)}</ul></section>')
+
+    body, nav = [], []
+
+    rota = [(parse_date(r.get("water_week")), norm_who(r.get("water_who"))) for r in rows]
+    rota = sorted((w, who) for w, who in rota if w)
+    if rota:
+        current = [x for x in rota if x[0] <= today][-1:] or rota[:1]
+        upcoming = current + [x for x in rota if x[0] > current[0][0]]
+        this_wk = current[0]
+        lines = [f'<li><b>Week of {fmt(w)}</b><span class="meta">{html.escape(who or "nobody yet")}</span></li>'
+                 for w, who in upcoming[1:]]
+        later = f'<details><summary>Later weeks</summary><ul>{"".join(lines[1:])}</ul></details>' if lines[1:] else ""
+        body.append(f'<section id="polytunnel"><h2>Polytunnel watering</h2>'
+                    f'<p class="left">Week of {fmt(this_wk[0])}</p><p class="big">{html.escape(this_wk[1] or "Nobody yet")}</p>'
+                    f'<ul>{"".join(lines[:1])}</ul>{later}</section>')
+        nav.append(("polytunnel", "Polytunnel"))
+
+    soon = [r for r in open_ if (parse_date(r.get("due")) or date.max) <= horizon]
+    late = sum(1 for r in soon if parse_date(r.get("due")) < today)
+    body.append(section("soon", f'Due by {fmt(horizon)}', f"{len(soon)} tasks, {late} overdue" if late else f"{len(soon)} tasks",
+                        [item(r, True) for r in soon]))
+    nav.append(("soon", "Due soon"))
+
+    people = {}
+    for r in open_:
+        people.setdefault(norm_who(r.get("who")), []).append(r)
+    for i, who in enumerate(sorted(people, key=lambda w: (w != "", w.lower()))):
+        rs = people[who]
+        anchor = f"p{i}"
+        name = who or "Nobody yet"
+        sub = f"{len(rs)} open" + (" · needs a name" if not who else "")
+        body.append(section(anchor, html.escape(name), sub, [item(r, False) for r in rs]))
+        nav.append((anchor, name))
+
+    if done:
+        body.append(f'<details id="done"><summary>Done ({len(done)})</summary><ul>{"".join(item(r, True) for r in done)}</ul></details>')
+        nav.append(("done", "Done"))
+
+    links = "".join(f'<a href="#{a}">{html.escape(t)}</a>' for a, t in nav)
+    return f'<nav>{links}</nav>{"".join(body)}', TASK_STYLE
+
+
 def build(d, today=None):
     today = today or date.today()
     cfg = json.load(open(os.path.join(d, "board.json")))
     with open(os.path.join(d, cfg["data"]), newline="") as f:
         rows = list(csv.DictReader(f))
+    if cfg.get("layout") == "tasks":
+        content, extra = build_tasks(rows, today)
+        page = (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
+                f'<title>{html.escape(cfg["title"])}</title><style>{STYLE}\n{extra}</style></head><body>'
+                f'<h1>{html.escape(cfg["title"])}</h1><p class="purpose">{html.escape(cfg.get("purpose", ""))}</p>'
+                f'{content}<footer>Updated {fmt(today)}</footer></body></html>\n')
+        with open(os.path.join(d, "index.html"), "w") as f:
+            f.write(page)
+        return
     sec = cfg["section"]
     groups = {}
     for r in rows:
