index 0000000..48d8a06
--- /dev/null
+++ b/kit/tasks.py
@@ -0,0 +1,128 @@
+"""Layout for the committee's task board (board.json "kind": "tasks"), built through kit/board.py.
+
+The task sheet export has two tables side by side: the tasks, and the polytunnel watering rota in the
+water_week/water_who columns. Views come from what the committee asked for in the minutes (Oct-Nov 2026):
+the rota where Dot can see it at the gate, what's due before the next meeting, what has nobody's name on it,
+each person's own list without sideways scrolling, and the done tasks out of the way.
+"""
+import csv, html, os
+from datetime import timedelta
+
+from board import STYLE, fmt, parse_date
+
+WORDS = {"todo": "To do", "in_progress": "Under way", "waiting": "Waiting", "done": "Done"}
+EXTRA = """nav{margin:0 0 12px}nav a{display:inline-block;margin:0 6px 6px 0;padding:4px 10px;border:1px solid #ccc;border-radius:16px;background:#fff;color:#222;text-decoration:none}
+.late{color:#b71c1c;font-weight:bold}.soon{color:#e65100;font-weight:bold}.gap{color:#b71c1c;font-weight:bold}
+.rota li{display:flex;justify-content:space-between}.rota .now{font-weight:bold;background:#e8f5e9}"""
+
+
+def esc(s):
+    return html.escape(s or "")
+
+
+def load(path):
+    """Read the export, tidying the spellings the spreadsheet lets through ("Done", "priya")."""
+    with open(path, newline="") as f:
+        rows = list(csv.DictReader(f))
+    tasks, rota = [], []
+    for r in rows:
+        r = {k: (v or "").strip() for k, v in r.items()}
+        if r.get("task"):
+            r["status"] = r["status"].lower()
+            r["who"] = r["who"][:1].upper() + r["who"][1:]
+            r["due_d"] = parse_date(r["due"])
+            tasks.append(r)
+        wk = parse_date(r.get("water_week"))
+        if wk:
+            who = r.get("water_who", "")
+            rota.append((wk, who[:1].upper() + who[1:]))
+    return tasks, sorted(rota)
+
+
+def due_text(t, today, cutoff):
+    d = t["due_d"]
+    if not d:
+        return ""
+    if t["status"] != "done" and d < today:
+        return f'<span class="late">overdue since {fmt(d)}</span>'
+    if t["status"] != "done" and d <= cutoff:
+        return f'<span class="soon">due {fmt(d)}</span>'
+    return f"due {fmt(d)}"
+
+
+def item(t, today, cutoff, show_who=True):
+    meta = []
+    if show_who:
+        meta.append(esc(t["who"]) if t["who"] else '<span class="gap">nobody yet</span>')
+    meta.append(due_text(t, today, cutoff))
+    meta.append(esc(WORDS.get(t["status"], t["status"])))
+    if t.get("waiting_on"):
+        meta.append("waiting on " + esc(t["waiting_on"]))
+    if t.get("qty"):
+        meta.append("qty " + esc(t["qty"]))
+    note = f'<div class="note">{esc(t["notes"])}</div>' if t.get("notes") else ""
+    sep = " · "  # outside the f-string: backslashes inside one need Python 3.12+
+    return f'<li><b>{esc(t["task"])}</b><span class="meta">{sep.join(m for m in meta if m)}</span>{note}</li>'
+
+
+def section(title, inner, sid="", sub=""):
+    ident = f' id="{sid}"' if sid else ""
+    subline = f'<p class="left">{sub}</p>' if sub else ""
+    return f"<section{ident}><h2>{title}</h2>{subline}{inner}</section>"
+
+
+def rota_html(rota, today):
+    if not rota:
+        return ""
+    this_week = [w for w, _ in rota if w <= today < w + timedelta(days=7)]
+    current = this_week[0] if this_week else None
+    lis = []
+    for w, who in rota:
+        if w + timedelta(days=7) <= today:
+            continue  # past weeks
+        cls = ' class="now"' if w == current else ""
+        name = esc(who) if who else '<span class="gap">nobody yet</span>'
+        label = "This week" if w == current else f"Week of {fmt(w)}"
+        lis.append(f"<li{cls}><span>{label}</span><span>{name}</span></li>")
+    return section("Polytunnel watering", f'<ul class="rota">{"".join(lis)}</ul>', "rota")
+
+
+def build(d, cfg, today):
+    tasks, rota = load(os.path.join(d, cfg["data"]))
+    cutoff = today + timedelta(days=7)
+    key = lambda t: (t["due_d"] is None, t["due_d"] or today)
+    open_ = sorted((t for t in tasks if t["status"] != "done"), key=key)
+    done = sorted((t for t in tasks if t["status"] == "done"), key=key, reverse=True)
+    people = sorted({t["who"] for t in open_ if t["who"]})
+
+    body = [rota_html(rota, today)]
+    soon = [t for t in open_ if t["due_d"] and t["due_d"] <= cutoff]
+    body.append(section(f"Due by {fmt(cutoff)}, or overdue",
+                        f'<ul>{"".join(item(t, today, cutoff) for t in soon)}</ul>' if soon else '<p class="left">Nothing.</p>',
+                        "soon", f"{len(soon)} tasks"))
+    nobody = [t for t in open_ if not t["who"]]
+    if nobody:
+        body.append(section("Nobody's name on it", f'<ul>{"".join(item(t, today, cutoff, False) for t in nobody)}</ul>',
+                            "nobody", f"{len(nobody)} tasks need someone"))
+    nav = "".join(f'<a href="#p-{esc(p.lower())}">{esc(p)}</a>' for p in people)
+    body.append(f'<nav>{nav}<a href="#nobody">Nobody</a><a href="#waiting">Waiting</a></nav>')
+    for p in people:
+        mine = [t for t in open_ if t["who"] == p]
+        n_soon = sum(1 for t in mine if t["due_d"] and t["due_d"] <= cutoff)
+        sub = f"{len(mine)} open" + (f", {n_soon} due by {fmt(cutoff)} or overdue" if n_soon else "")
+        body.append(section(esc(p), f'<ul>{"".join(item(t, today, cutoff, False) for t in mine)}</ul>', f"p-{esc(p.lower())}", sub))
+    waits = {}
+    for t in open_:
+        if t.get("waiting_on"):
+            waits.setdefault(t["waiting_on"], []).append(t)
+    if waits:
+        inner = "".join(f'<h2 class="when">On {esc(w)} ({len(ts)})</h2><ul>{"".join(item(t, today, cutoff) for t in ts)}</ul>'
+                        for w, ts in sorted(waits.items(), key=lambda kv: -len(kv[1])))
+        body.append(section("Waiting on someone outside", inner, "waiting"))
+    if done:
+        body.append(f'<details><summary>Done ({len(done)})</summary><ul>{"".join(item(t, today, cutoff) for t in done)}</ul></details>')
+
+    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
+            f'<title>{esc(cfg["title"])}</title><style>{STYLE}\n{EXTRA}</style></head><body>'
+            f'<h1>{esc(cfg["title"])}</h1><p class="purpose">{esc(cfg.get("purpose", ""))}</p>'
+            f'{"".join(body)}<footer>Updated {fmt(today)}</footer></body></html>\n')
