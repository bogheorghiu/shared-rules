diff --git a/kit/tasks.py b/kit/tasks.py
new file mode 100644
index 0000000..b7191d3
--- /dev/null
+++ b/kit/tasks.py
@@ -0,0 +1,111 @@
+"""Layout for the committee's tasks board (board.json "layout": "tasks"), built by kit/board.py.
+
+Built for what the committee asked for in the October/November minutes: the polytunnel rota where it can be
+seen at the gate; tasks with nobody's name on them first, since that is what keeps slipping; then what is
+overdue and what is due in the next week, so Thursday's meeting can start there instead of reading the whole
+sheet; each person's own list; done tasks folded away at the bottom.
+
+Reads the columns of the committee's task sheet export as it comes: task, who, due, status, waiting_on, qty,
+notes, and the rota in the side columns water_week, water_who.
+"""
+import html
+from datetime import timedelta
+
+from board import fmt, parse_date, write_page
+
+SEP = " \u00b7 "
+SOON_DAYS = 7  # "the things due by next Thursday" (minutes, 12 Nov): one meeting to the next
+STATUS = {"todo": "To do", "in_progress": "Under way", "waiting": "Waiting", "done": "Done"}
+STYLE = """.late{color:#b71c1c;font-weight:bold}h2 .n{color:#555;font-weight:normal}
+.rota li{display:flex;justify-content:space-between}.rota .now{font-weight:bold}details.person summary{font-weight:normal}"""
+
+
+def clean(r):
+    """The sheet is typed by hand: 'Done' and 'done', 'priya' and 'Priya' mean the same."""
+    who = (r.get("who") or "").strip()
+    return {
+        "task": (r.get("task") or "").strip(),
+        "who": who[:1].upper() + who[1:],
+        "due": parse_date(r.get("due")),
+        "status": (r.get("status") or "").strip().lower(),
+        "waiting_on": (r.get("waiting_on") or "").strip(),
+        "qty": (r.get("qty") or "").strip(),
+        "notes": (r.get("notes") or "").strip(),
+    }
+
+
+def item(t, today, show_who=True):
+    meta = []
+    if show_who:
+        meta.append(html.escape(t["who"] or "nobody yet"))
+    if t["due"]:
+        if t["status"] != "done" and t["due"] < today:
+            meta.append(f'<span class="late">overdue since {fmt(t["due"])}</span>')
+        else:
+            meta.append(f"due {fmt(t['due'])}")
+    meta.append(html.escape(STATUS.get(t["status"], t["status"])))
+    if t["waiting_on"] and t["status"] != "done":
+        meta.append("waiting on " + html.escape(t["waiting_on"]))
+    note = f"Quantity: {t['qty']} {t['notes']}".strip() if t["qty"] else t["notes"]
+    note = f'<div class="note">{html.escape(note)}</div>' if note else ""
+    return f'<li><b>{html.escape(t["task"])}</b><span class="meta">{" · ".join(meta)}</span>{note}</li>'
+
+
+def section(title, tasks, today, empty, show_who=True):
+    body = "".join(item(t, today, show_who) for t in tasks) if tasks else f'<li class="note">{empty}</li>'
+    return f'<section><h2>{title} <span class="n">({len(tasks)})</span></h2><ul>{body}</ul></section>'
+
+
+def rota(rows, today):
+    weeks = sorted((d, (r.get("water_who") or "").strip()) for r in rows if (d := parse_date(r.get("water_week"))))
+    current = [w for w in weeks if w[0] <= today]
+    shown = current[-1:] + [w for w in weeks if w[0] > today]
+    if not shown:
+        return ""
+    lis = "".join(
+        f'<li class="{"now" if i == 0 and d <= today else ""}"><span>{"This week" if i == 0 and d <= today else "Week of " + fmt(d)}</span>'
+        f'<span>{html.escape(who) if who else "nobody yet"}</span></li>'
+        for i, (d, who) in enumerate(shown))
+    return f'<section class="rota"><h2>Polytunnel watering</h2><ul>{lis}</ul></section>'
+
+
+def build(d, cfg, rows, today):
+    tasks = sorted((clean(r) for r in rows if (r.get("task") or "").strip()),
+                   key=lambda t: (t["due"] is None, t["due"] or today))
+    open_ = [t for t in tasks if t["status"] != "done"]
+    done = [t for t in tasks if t["status"] == "done"]
+    soon = today + timedelta(days=SOON_DAYS)
+
+    # Each open task appears in at most one of the three top sections, so their counts add up.
+    nobody = [t for t in open_ if not t["who"]]
+    overdue = [t for t in open_ if t["who"] and t["due"] and t["due"] < today]
+    due_soon = [t for t in open_ if t["who"] and t["due"] and today <= t["due"] <= soon]
+
+    body = [
+        rota(rows, today),
+        section("Nobody's name on it", nobody, today, "Every task has someone."),
+        section("Overdue", overdue, today, "Nothing overdue."),
+        section(f"Due by {fmt(soon)}", due_soon, today, "Nothing else due this week."),
+    ]
+
+    waiting = {}
+    for t in open_:
+        if t["waiting_on"]:
+            waiting.setdefault(t["waiting_on"], []).append(t)
+    if waiting:
+        inner = "".join(section(f"Waiting on {html.escape(k)}", v, today, "")
+                        for k, v in sorted(waiting.items(), key=lambda kv: -len(kv[1])))
+        n = sum(len(v) for v in waiting.values())
+        body.append(f"<details><summary>Waiting on someone outside the committee ({n})</summary>{inner}</details>")
+
+    people = sorted({t["who"] for t in open_ if t["who"]})
+    inner = "".join(
+        f'<details class="person"><summary>{html.escape(p)} ({sum(t["who"] == p for t in open_)})</summary>'
+        f'<ul>{"".join(item(t, today, show_who=False) for t in open_ if t["who"] == p)}</ul></details>'
+        for p in people)
+    body.append(f'<section><h2>Everyone\'s tasks</h2>{inner}</section>')
+
+    if done:
+        body.append(f'<details><summary>Done ({len(done)})</summary><ul>{"".join(item(t, today) for t in done)}</ul></details>')
+
+    write_page(d, cfg, body, today, STYLE)
