index 0000000..56650e7
--- /dev/null
+++ b/kit/tasks_board.py
@@ -0,0 +1,126 @@
+"""The tasks board's page. kit/board.py calls this for a board.json with "layout": "tasks".
+
+Reads the committee's task-sheet export (columns: task, who, due, status, waiting_on, qty, notes, water_week,
+water_who). Why each section exists is in docs/tasks-board.md.
+"""
+import csv, html, os
+from datetime import timedelta
+
+from board import STYLE, fmt, parse_date
+
+EXTRA = """.late{color:#b71c1c;font-weight:bold}.soon{color:#2e7d32;font-weight:bold}.nobody{color:#b71c1c}
+details.person{border-top:1px solid #eee}details.person summary{font-weight:normal}.this{background:#e8f5e9}"""
+
+STATUS = {"todo": "To do", "in_progress": "Under way", "waiting": "Waiting", "done": "Done"}
+
+
+def esc(s):
+    return html.escape(s)
+
+
+def tidy_name(s):
+    s = (s or "").strip()
+    return s[:1].upper() + s[1:] if s.islower() else s
+
+
+def next_meeting(today):
+    # Committee meets on Thursdays; on a Thursday, "next" means the following week's.
+    return today + timedelta(days=(3 - today.weekday()) % 7 or 7)
+
+
+def item(t, today, thursday, show_who=True):
+    meta = []
+    if show_who:
+        meta.append(esc(t["who"]) if t["who"] else '<span class="nobody">nobody yet</span>')
+    if t["due"]:
+        flag = ""
+        if t["due"] < today:
+            flag = ' <span class="late">overdue</span>'
+        elif t["due"] <= thursday:
+            flag = ' <span class="soon">this week</span>'
+        meta.append(f"due {fmt(t['due'])}{flag}")
+    meta.append(STATUS.get(t["status"], esc(t["status"])))
+    if t["waiting_on"]:
+        meta.append(f"waiting on {esc(t['waiting_on'])}")
+    if t["qty"]:
+        meta.append(f"qty {esc(t['qty'])}")
+    note = f'<div class="note">{esc(t["notes"])}</div>' if t["notes"] else ""
+    return f'<li><b>{esc(t["task"])}</b><span class="meta">{" · ".join(meta)}</span>{note}</li>'
+
+
+def section(title, inner, kit, sub=""):
+    sub = f'<p class="left">{sub}</p>' if sub else ""
+    return f'<section data-kit="{kit}"><h2>{title}</h2>{sub}{inner}</section>'
+
+
+def ul(tasks, today, thursday, show_who=True):
+    return "<ul>" + "".join(item(t, today, thursday, show_who) for t in tasks) + "</ul>"
+
+
+def build(d, cfg, today):
+    with open(os.path.join(d, cfg["data"]), newline="") as f:
+        rows = list(csv.DictReader(f))
+    thursday = next_meeting(today)
+    tasks, rota = [], []
+    for r in rows:
+        g = lambda k: (r.get(k) or "").strip()
+        if g("task"):
+            tasks.append(dict(task=g("task"), who=tidy_name(g("who")), due=parse_date(g("due")),
+                              status=g("status").lower(), waiting_on=g("waiting_on"), qty=g("qty"), notes=g("notes")))
+        week = parse_date(g("water_week"))
+        if week:
+            rota.append((week, tidy_name(g("water_who"))))
+    by_due = lambda t: (t["due"] is None, t["due"] or today)
+    open_ = sorted((t for t in tasks if t["status"] != "done"), key=by_due)
+    done = [t for t in tasks if t["status"] == "done"]
+
+    body = []
+    soon = [t for t in open_ if t["due"] and t["due"] <= thursday]
+    body.append(section(f"Before Thursday {thursday.day} {thursday:%b}",
+                        ul(soon, today, thursday) if soon else '<p class="left">nothing due</p>', "soon",
+                        "overdue, or due by the next meeting"))
+
+    nobody = [t for t in open_ if not t["who"]]
+    if nobody:
+        body.append(section("Nobody's name on it", ul(nobody, today, thursday, False), "nobody"))
+
+    people = {}
+    for t in open_:
+        if t["who"]:
+            people.setdefault(t["who"], []).append(t)
+    folds = []
+    for who in sorted(people):
+        ts = people[who]
+        late = sum(1 for t in ts if t["due"] and t["due"] < today)
+        wk = sum(1 for t in ts if t["due"] and today <= t["due"] <= thursday)
+        counts = [f"{len(ts)} open"] + ([f'<span class="late">{late} overdue</span>'] if late else []) \
+            + ([f'<span class="soon">{wk} this week</span>'] if wk else [])
+        folds.append(f'<details class="person" data-kit="person"><summary><b>{esc(who)}</b> · {" · ".join(counts)}</summary>'
+                     f'{ul(ts, today, thursday, False)}</details>')
+    body.append(section("Everyone's list", "".join(folds), "people", "tap a name"))
+
+    waiting = {}
+    for t in open_:
+        if t["waiting_on"]:
+            waiting.setdefault(t["waiting_on"], []).append(t)
+    if waiting:
+        inner = "".join(f'<h2 class="when">{esc(w)} ({len(ts)})</h2>{ul(ts, today, thursday)}'
+                        for w, ts in sorted(waiting.items(), key=lambda kv: -len(kv[1])))
+        body.append(section("Waiting on someone else", inner, "waiting"))
+
+    current = [(w, who) for w, who in sorted(rota) if w + timedelta(days=6) >= today]
+    if current:
+        lis = "".join(f'<li{" class=\"this\"" if w <= today else ""}><b>w/c {fmt(w)}</b><span class="meta">'
+                      f'{esc(who) if who else "<span class=nobody>nobody yet</span>"}</span></li>' for w, who in current)
+        body.append(section("Polytunnel watering", f"<ul>{lis}</ul>", "rota"))
+
+    if done:
+        body.append(f'<details data-kit="done"><summary>Done ({len(done)})</summary>'
+                    f'<section>{ul(done, today, thursday)}</section></details>')
+
+    page = (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
+            f'<title>{esc(cfg["title"])}</title><style>{STYLE}\n{EXTRA}</style></head><body>'
+            f'<h1>{esc(cfg["title"])}</h1><p class="purpose">{esc(cfg.get("purpose", ""))}</p>'
+            f'{"".join(body)}<footer>Updated {fmt(today)}</footer></body></html>\n')
+    with open(os.path.join(d, "index.html"), "w") as f:
+        f.write(page)
